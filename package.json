{
  "name": "eulers-harness",
  "version": "0.3.9",
  "description": "Vulktek desktop agent harness powered by Pi SDK",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Phoenix",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview --noSandbox",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "probe": "PI_CODING_AGENT_DIR=$PWD/.euler-agent node scripts/probe-agent.mjs",
    "dist": "electron-vite build && electron-builder --linux --win",
    "dist:win": "electron-builder --win --x64 --dir -c.npmRebuild=false -c.win.signAndEditExecutable=false",
    "dist:linux": "electron-builder --linux --x64 --dir -c.npmRebuild=false",
    "publish:release": "node scripts/publish-release.mjs"
  },
  "build": {
    "appId": "com.vulktek.eulers-harness",
    "productName": "Eulers Harness",
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "better-sqlite3": "13.2.0",
    "highlight.js": "11.11.1",
    "marked": "18.2.1",
    "solid-js": "1.9.20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite-plugin-solid": "2.11.10"
  }
}
